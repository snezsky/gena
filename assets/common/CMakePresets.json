{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conf-common",
            "description": "General settings that apply to all configurations",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
<% if project_type == "Library" %>
                "<@ upper(namespace) @>_BUILD_EXAMPLES": "ON",
<% endif %>
                "<@ upper(namespace) @>_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "conf-windows-common",
            "description": "Windows settings for MSBuild toolchain",
            "hidden": true,
            "inherits": "conf-common",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "enableClangTidyCodeAnalysis": true
                }
            }
        },
        {
            "name": "conf-unixlike-common",
            "description": "Unix-like OS settings for gcc and clang toolchains",
            "hidden": true,
            "inherits": "conf-common",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "vendor": {
                "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
                    "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
                }
            }
        },
        {
            "name": "conf-debug-common",
            "hidden": true,
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "conf-release-common",
            "hidden": true,
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "conf-relwithdebinfo-common",
            "hidden": true,
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "conf-gcc-common",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "conf-clang-common",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "Debug",
            "description": "Target Windows with the msvc compiler, debug build type",
            "inherits": [ "conf-windows-common", "conf-debug-common" ]
        },
        {
            "name": "msvc-release",
            "displayName": "Release",
            "description": "Target Windows with the msvc compiler, release build type",
            "inherits": [ "conf-windows-common", "conf-release-common" ]
        },
        {
            "name": "msvc-relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "Target Windows with the msvc compiler, release build type with debug information",
            "inherits": [ "conf-windows-common", "conf-relwithdebinfo-common" ]
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "description": "Target Unix-like OS with the gcc compiler, debug build type",
            "inherits": [ "conf-unixlike-common", "conf-gcc-common", "conf-debug-common" ]
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "description": "Target Unix-like OS with the gcc compiler, release build type",
            "inherits": [ "conf-unixlike-common", "conf-gcc-common", "conf-release-common" ]
        },
        {
            "name": "gcc-relwithdebinfo",
            "displayName": "GCC RelWithDebInfo",
            "description": "Target Unix-like OS with the gcc compiler, release build type with debug information",
            "inherits": [ "conf-unixlike-common", "conf-gcc-common", "conf-relwithdebinfo-common" ]
        },
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "description": "Target Unix-like OS with the clang compiler, debug build type",
            "inherits": [ "conf-unixlike-common", "conf-clang-common", "conf-debug-common" ]
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "description": "Target Unix-like OS with the clang compiler, release build type",
            "inherits": [ "conf-unixlike-common", "conf-clang-common", "conf-release-common" ]
        },
        {
            "name": "clang-relwithdebinfo",
            "displayName": "Clang RelWithDebInfo",
            "description": "Target Unix-like OS with the clang compiler, release build type with debug information",
            "inherits": [ "conf-unixlike-common", "conf-clang-common", "conf-relwithdebinfo-common" ]
        }
    ],
    "buildPresets": [
        {
            "name": "build-windows-common",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "build-unixlike-common",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "msvc-debug",
            "inherits": "build-windows-common",
            "configurePreset": "msvc-debug"
        },
        {
            "name": "msvc-release",
            "inherits": "build-windows-common",
            "configurePreset": "msvc-release"
        },
        {
            "name": "msvc-relwithdebinfo",
            "inherits": "build-windows-common",
            "configurePreset": "msvc-relwithdebinfo"
        },
        {
            "name": "gcc-debug",
            "inherits": "build-unixlike-common",
            "configurePreset": "gcc-debug"
        },
        {
            "name": "gcc-release",
            "inherits": "build-unixlike-common",
            "configurePreset": "gcc-release"
        },
        {
            "name": "gcc-relwithdebinfo",
            "inherits": "build-unixlike-common",
            "configurePreset": "gcc-relwithdebinfo"
        },
        {
            "name": "clang-debug",
            "inherits": "build-unixlike-common",
            "configurePreset": "clang-debug"
        },
        {
            "name": "clang-release",
            "inherits": "build-unixlike-common",
            "configurePreset": "clang-release"
        },
        {
            "name": "clang-relwithdebinfo",
            "inherits": "build-unixlike-common",
            "configurePreset": "clang-relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "test-common",
            "description": "Test CMake settings that apply to all configurations",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-windows-common",
            "hidden": true,
            "inherits": "test-common",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "test-unixlike-common",
            "hidden": true,
            "inherits": "test-common",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "inherits": "test-windows-common",
            "name": "test-msvc-debug",
            "configurePreset": "msvc-debug"
        },
        {
            "inherits": "test-windows-common",
            "name": "test-msvc-release",
            "configurePreset": "msvc-release"
        },
        {
            "inherits": "test-windows-common",
            "name": "test-msvc-relwithdebinfo",
            "configurePreset": "msvc-relwithdebinfo"
        },
        {
            "inherits": "test-unixlike-common",
            "name": "test-gcc-debug",
            "configurePreset": "gcc-debug"
        },
        {
            "inherits": "test-unixlike-common",
            "name": "test-gcc-release",
            "configurePreset": "gcc-release"
        },
        {
            "inherits": "test-unixlike-common",
            "name": "test-gcc-relwithdebinfo",
            "configurePreset": "gcc-relwithdebinfo"
        },
        {
            "inherits": "test-unixlike-common",
            "name": "test-clang-debug",
            "configurePreset": "clang-debug"
        },
        {
            "inherits": "test-unixlike-common",
            "name": "test-clang-release",
            "configurePreset": "clang-release"
        },
        {
            "inherits": "test-unixlike-common",
            "name": "test-clang-relwithdebinfo",
            "configurePreset": "clang-relwithdebinfo"
        }
    ],
    "workflowPresets": [
        {
            "name": "msvc-debug",
            "steps": [
                { "type": "configure", "name": "msvc-debug" },
                { "type": "build", "name": "msvc-debug" },
                { "type": "test", "name": "test-msvc-debug" }
            ]
        },
        {
            "name": "msvc-release",
            "steps": [
                { "type": "configure", "name": "msvc-release" },
                { "type": "build", "name": "msvc-release" },
                { "type": "test", "name": "test-msvc-release" }
            ]
        },
        {
            "name": "msvc-relwithdebinfo",
            "steps": [
                { "type": "configure", "name": "msvc-relwithdebinfo" },
                { "type": "build", "name": "msvc-relwithdebinfo" },
                { "type": "test", "name": "test-msvc-relwithdebinfo" }
            ]
        },
        {
            "name": "gcc-debug",
            "steps": [
                { "type": "configure", "name": "gcc-debug" },
                { "type": "build", "name": "gcc-debug" },
                { "type": "test", "name": "test-gcc-debug" }
            ]
        },
        {
            "name": "gcc-release",
            "steps": [
                { "type": "configure", "name": "gcc-release" },
                { "type": "build", "name": "gcc-release" },
                { "type": "test", "name": "test-gcc-release" }
            ]
        },
        {
            "name": "gcc-relwithdebinfo",
            "steps": [
                { "type": "configure", "name": "gcc-relwithdebinfo" },
                { "type": "build", "name": "gcc-relwithdebinfo" },
                { "type": "test", "name": "test-gcc-relwithdebinfo" }
            ]
        },
        {
            "name": "clang-debug",
            "steps": [
                { "type": "configure", "name": "clang-debug" },
                { "type": "build", "name": "clang-debug" },
                { "type": "test", "name": "test-clang-debug" }
            ]
        },
        {
            "name": "clang-release",
            "steps": [
                { "type": "configure", "name": "clang-release" },
                { "type": "build", "name": "clang-release" },
                { "type": "test", "name": "test-clang-release" }
            ]
        },
        {
            "name": "clang-relwithdebinfo",
            "steps": [
                { "type": "configure", "name": "clang-relwithdebinfo" },
                { "type": "build", "name": "clang-relwithdebinfo" },
                { "type": "test", "name": "test-clang-relwithdebinfo" }
            ]
        }
    ]
}
